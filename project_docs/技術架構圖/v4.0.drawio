        <mxCell id="qfxM0qB_LzybIYW7OscD-66" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;存放中低頻k線資料&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
