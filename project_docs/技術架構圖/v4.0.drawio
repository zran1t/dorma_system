          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qfxM0qB_LzybIYW7OscD-71" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;收到調用的訊息後，讓redis短時間負載&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
