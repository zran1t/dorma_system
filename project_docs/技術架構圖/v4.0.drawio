        <mxCell id="kVyVzw51nabYIgb5NT_a-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="qfxM0qB_LzybIYW7OscD-73" target="kVyVzw51nabYIgb5NT_a-1" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qfxM0qB_LzybIYW7OscD-73" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;錯誤重啟可直接讀取延遲層資料&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="335.5" y="-271" width="217" height="25" as="geometry" />
        </mxCell>
        <mxCell id="kVyVzw51nabYIgb5NT_a-1" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;TTL管控資料存在時間&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="361.5" y="-205" width="165" height="30" as="geometry" />
        </mxCell>
        <mxCell id="kVyVzw51nabYIgb5NT_a-27" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;近期快照層&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-240.5" y="964.9300000000001" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="kVyVzw51nabYIgb5NT_a-51" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;Redis 推送層&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-1120" y="246.99999999999997" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="kVyVzw51nabYIgb5NT_a-52" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;Redis 快取層&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-1120" y="345" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="kVyVzw51nabYIgb5NT_a-53" value="&lt;p class=&quot;p1&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Redis 延遲層&lt;/font&gt;&lt;/p&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-1120" y="443" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="kNV1jPLKynKexbDa8O9D-9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="kVyVzw51nabYIgb5NT_a-77" target="kVyVzw51nabYIgb5NT_a-78" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kVyVzw51nabYIgb5NT_a-77" value="Redis Stream 作為輔助角色，永遠保存著最新一筆資料（不是整包，是最新的更新資料）" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="-1389.5" y="-340" width="480" height="18" as="geometry" />
        </mxCell>
        <mxCell id="kVyVzw51nabYIgb5NT_a-78" value="在模組設計裡當沒順利接收到zeroMQ的推播時，就會啟用第二層通道主動查詢Redis Stream" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="-1399" y="-270.5" width="499" height="24.5" as="geometry" />
        </mxCell>
        <mxCell id="kNV1jPLKynKexbDa8O9D-14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="kVyVzw51nabYIgb5NT_a-85" target="kNV1jPLKynKexbDa8O9D-12" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kVyVzw51nabYIgb5NT_a-85" value="為了配合推播層架構，快速推播資料" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="-729.25" y="-486" width="256.5" height="38" as="geometry" />
        </mxCell>
        <mxCell id="kNV1jPLKynKexbDa8O9D-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="kNV1jPLKynKexbDa8O9D-3" target="kVyVzw51nabYIgb5NT_a-77" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kNV1jPLKynKexbDa8O9D-3" value="&lt;span style=&quot;color: rgb(0, 0, 0); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: nowrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;在zeroMQ推播後，不同時間級別會立刻併發寫入Redis&amp;nbsp;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: nowrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;(不用lock Redis 可真正同時寫入，因為k線有很多種時間級別需同時刷新&lt;/span&gt;&lt;span style=&quot;text-wrap-mode: nowrap; background-color: transparent;&quot;&gt;）&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="-1346.5" y="-425" width="394" height="42" as="geometry" />
        </mxCell>
        <mxCell id="kNV1jPLKynKexbDa8O9D-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="kNV1jPLKynKexbDa8O9D-4" target="kNV1jPLKynKexbDa8O9D-3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kNV1jPLKynKexbDa8O9D-4" value="&lt;span style=&quot;color: rgb(0, 0, 0); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: nowrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;zeroMQ可在websocket刷新的當下立馬推播最新資料，可達到幾乎無延遲推播&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="-1369" y="-491" width="439" height="30" as="geometry" />
        </mxCell>
        <mxCell id="kNV1jPLKynKexbDa8O9D-17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="kNV1jPLKynKexbDa8O9D-12" target="kNV1jPLKynKexbDa8O9D-16" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kNV1jPLKynKexbDa8O9D-12" value="&lt;span style=&quot;color: rgb(0, 0, 0); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: nowrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;快取儲存所需的Ｋ線資料，當新資料推過來&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: nowrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;快取層會滾動刷新每一個時間級別&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="-720.5" y="-400" width="239" height="30" as="geometry" />
        </mxCell>
        <mxCell id="Z1Y-C-lL68JUMD8jI4OI-11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="kNV1jPLKynKexbDa8O9D-15" target="Z1Y-C-lL68JUMD8jI4OI-7" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kNV1jPLKynKexbDa8O9D-15" value="&lt;span style=&quot;color: rgb(0, 0, 0); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: nowrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;相同地，若未能順利收到zeroMQ推播，就啟用第二通道&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="-758" y="-235" width="314" height="30" as="geometry" />
        </mxCell>
        <mxCell id="kNV1jPLKynKexbDa8O9D-18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="kNV1jPLKynKexbDa8O9D-16" target="kNV1jPLKynKexbDa8O9D-15" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kNV1jPLKynKexbDa8O9D-16" value="一樣是可以真正的同時寫入，同時刷新所有時間級別資料" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="-779" y="-318" width="356" height="30" as="geometry" />
        </mxCell>
        <mxCell id="Z1Y-C-lL68JUMD8jI4OI-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="kNV1jPLKynKexbDa8O9D-22" target="Z1Y-C-lL68JUMD8jI4OI-1" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kNV1jPLKynKexbDa8O9D-22" value="為了減少推播層redis 記憶體壓力 ，所以每當資料刷一次，就資料就會寫進此處確保推播層第二通道永遠只保留最新資料" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="-325" y="-467" width="328" height="47" as="geometry" />
        </mxCell>
        <mxCell id="kNV1jPLKynKexbDa8O9D-23" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;Redis 快照層&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-1120" y="541" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Z1Y-C-lL68JUMD8jI4OI-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="Z1Y-C-lL68JUMD8jI4OI-1" target="Z1Y-C-lL68JUMD8jI4OI-3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Z1Y-C-lL68JUMD8jI4OI-1" value="當收到模組需要系統風控計算等需要對應的資料提早廣播，即寫入redis以共對應模組查詢" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="-293" y="-392" width="264" height="50" as="geometry" />
        </mxCell>
        <mxCell id="Z1Y-C-lL68JUMD8jI4OI-3" value="如此能避免資源浪費，此屬於低頻查詢，長時間待機於redis內部，只會增加整體記憶體佔用率" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="-289.62" y="-320" width="257.25" height="30" as="geometry" />
        </mxCell>
        <mxCell id="Z1Y-C-lL68JUMD8jI4OI-7" value="Ticker重構部分 則是用來幫助進出場，重構出當前未收盤k棒" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="-761.5" y="-150" width="321" height="24" as="geometry" />
        </mxCell>
